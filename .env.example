# Safe runtime defaults. Keep these values for normal paper deployment.
MODE=paper
TRADING_MODE=paper
LIVE_TRADING=false
PAPER_TRADING=true
DEMO_TRADING=false
DATABASE_PATH=data/silver_bot.sqlite3
EXCHANGE_NAME=binance_futures
SYMBOL=BTCUSDT
TIMEFRAME=1m

# Optional. Do not commit real secrets in .env files.
# Leave blank for backtest/paper unless an exchange data feature explicitly needs them.
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=false
BINANCE_FUTURES_BASE_URL=

# Optional paper-mode alerts. Disabled by default.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional ML probability filter. Disabled by default.
ML_FILTER_ENABLED=false
ML_REGISTRY_PATH=models/model_registry.json
ML_MIN_PROBABILITY=0.60
ML_REDUCE_RISK_THRESHOLD=0.55

# Live readiness gate. These do not enable live execution in the current app.
# They are used only by `python -m silver_bot.readiness`.
READINESS_CHECK_PASSED=false
RISK_ENGINE_ENABLED=true
KILL_SWITCH_ENABLED=false
KILL_SWITCH_PATH=
STOP_LOSS_REQUIRED=true
TELEGRAM_ALERTS_TESTED=false
API_WITHDRAWALS_DISABLED=false
MAX_RISK_PER_TRADE=0.005
MAX_DAILY_LOSS=0.02
MAX_LEVERAGE=3
BACKTEST_REPORT_PATH=reports/backtest_report.json
OOS_VALIDATION_REPORT_PATH=reports/out_of_sample_validation_report.json
PAPER_TRADING_REPORT_PATH=reports/paper_trading_report.json

# Binance Futures Demo/Testnet example values. Keep these disabled unless you
# are intentionally validating demo/testnet readiness with demo API keys.
# MODE=demo
# TRADING_MODE=demo
# DEMO_TRADING=true
# BINANCE_TESTNET=true
# LIVE_TRADING=false
# PAPER_TRADING=false
# BINANCE_API_KEY=<demo-testnet-api-key>
# BINANCE_API_SECRET=<demo-testnet-api-secret>
# BINANCE_FUTURES_BASE_URL=https://testnet.binancefuture.com
# RISK_ENGINE_ENABLED=true
# KILL_SWITCH_ENABLED=true
# KILL_SWITCH_PATH=KILL_SWITCH
# STOP_LOSS_REQUIRED=true
